# Upstash Redis KV Configuration
# Get these from: https://console.upstash.com/
KV_REST_API_URL=https://your-redis-instance.upstash.io
KV_REST_API_TOKEN=your-token-here

# Editor Authentication Secret
# Generate a strong random secret for production
# Example: openssl rand -base64 32
EDITOR_SECRET=your-strong-secret-here

# For Vercel deployment:
# 1. Go to your Vercel project settings
# 2. Navigate to "Storage" tab
# 3. Create a new Upstash Redis (KV) instance (or connect existing)
# 4. Vercel will automatically set KV_REST_API_URL and KV_REST_API_TOKEN
# 5. Manually add EDITOR_SECRET in "Environment Variables" section
